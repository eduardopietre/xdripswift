/// when NFC scanning is started, this message will appear
"holdTopOfIphoneNearSensor" = "Trzymaj górną część iPhone'a przy sensorze, aż przestanie wibrować.";

/// The user has connected to another (older?) Libre 2 with bluetooth than the one for which NFC scan was done, in that case, inform user that he/she should click 'disconnect', add a new CGM sensor and scan again.
"connectedLibre2DoesNotMatchScannedLibre2" = "Zeskanowano nowy sensor Libre, ale %@ połączył się z innym sensorem (prawdopodobnie poprzednim).\n\nAby to rozwiązać, NIE usuwaj jeszcze starego sensora. Kliknij „Rozłącz” lub „Zatrzymaj skanowanie”, wróć do poprzedniego ekranu, dodaj nowy CGM typu Libre 2 i zeskanuj sensor ponownie.\n\n%@ powinien teraz spróbować połączyć się z nowym sensorem.";

/// After Libre NFC scanning, and after successful bluetooth connection, this message will be shown to explain that he or she should not allow bluetooth permission on the Libre app
"donotusethelibrelinkapp" = "Połączono z Libre 2.\n\nUpewnij się, że wyłączono zgodę na Bluetooth dla aplikacji Libre w ustawieniach iPhone'a.\n\nJeśli tego nie zrobisz, skanowanie aplikacją Libre przerwie połączenie między %@ a Libre 2.\n\nPo uruchomieniu nowego Libre 2 obowiązuje %@-minutowy okres rozgrzewki, zanim pojawią się odczyty.";

/// after scanning NFC, scan complete message
"scanComplete" = "Skanowanie sensora udane";
